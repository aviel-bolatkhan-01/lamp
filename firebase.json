{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      ".github/**",
      ".claude/**",
      "node_modules/**",
      "android/**",
      "**/*.md",
      "database.rules.json",
      "gen-landing-page.js",
      "gen-seo-pages.js",
      "eslint.config.js",
      "package.json",
      "package-lock.json",
      "_*.py",
      "_*.html",
      "_res*.jsonl",
      "_srv.log"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
